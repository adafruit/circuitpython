USB_VID = 0x239A
USB_PID = 0x8152
USB_PRODUCT = "Floppsy RP2350"
USB_MANUFACTURER = "Adafruit"

CHIP_VARIANT = RP2350
CHIP_PACKAGE = B
CHIP_FAMILY = rp2

EXTERNAL_FLASH_DEVICES = "W25Q128JVxQ"

CIRCUITPY_SDIOIO = 1
CIRCUITPY_PICODVI = 0

# Allow full-speed USB camera descriptors and isochronous IN transfers.
CFLAGS += -DCFG_TUH_ENUMERATION_BUFSIZE=4096
CFLAGS += -DPIO_USB_HOST_ISOCHRONOUS=1
