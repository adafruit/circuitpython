USB_VID = 0x32AC
USB_PID = 0x001F
USB_PRODUCT = "Laptop 16 Input Module"
USB_MANUFACTURER = "Framework Computer Inc"

CHIP_VARIANT = RP2040
CHIP_FAMILY = rp2

EXTERNAL_FLASH_DEVICES = "W25Q80DV"

# Flash is only 1 MB. Shrink the firmware to leave room for CIRCUITPY.
# Must be accompanied by a linker script change
CFLAGS += -DCIRCUITPY_FIRMWARE_SIZE='(512 * 1024)'

# Not usable on this hardware: no speaker, display, or free GPIO headers.
CIRCUITPY_AUDIOBUSIO = 0
CIRCUITPY_AUDIOCORE = 0
CIRCUITPY_AUDIOEFFECTS = 0
CIRCUITPY_AUDIOFILEWRITER = 0
CIRCUITPY_AUDIOMIXER = 0
CIRCUITPY_AUDIOMP3 = 0
CIRCUITPY_AUDIOPWMIO = 0
CIRCUITPY_AUDIOSPEED = 0
CIRCUITPY_BLEIO_HCI = 0
CIRCUITPY_DISPLAYIO = 0
CIRCUITPY_IMAGECAPTURE = 0
CIRCUITPY_PICODVI = 0
CIRCUITPY_PS2IO = 0
CIRCUITPY_ROTARYIO = 0
CIRCUITPY_SYNTHIO = 0
CIRCUITPY_ULAB = 0
CIRCUITPY_USB_AUDIO = 0
CIRCUITPY_USB_HOST = 0
CIRCUITPY_USB_MIDI = 0
CIRCUITPY_USB_VIDEO = 0
